+    return re.sub(r"[^\w']+", "", token)
+
+
+def align_words_to_script(words: list, script_text: str, keep_heard_digits: bool = True) -> list:
+    """Keep whisper's timing, take the spelling from the script.
+
+    AI Shorts voices are generated from a known script, so the script is the
+    truth for *what* is said and whisper only has to say *when*. Transcript
+    tokens are aligned to script tokens; matched runs keep their timestamps,
+    mismatched runs spread the script words over the same time span, and
+    transcript-only words (fillers, hallucinations) are dropped. A run where
+    whisper heard digits ("55") keeps the digits, they read better on screen
+    (keep_heard_digits=False returns exactly one entry per script word).
+    """
+    script_tokens = []
+    for token in script_text.split():
+        if _norm_token(token):
+            script_tokens.append(token)
+        elif script_tokens:  # a bare "—" or "&" stays glued to the word before it
+            script_tokens[-1] += " " + token
+    if not words or not script_tokens:
+        return words
+    heard = [_norm_token(w["word"]) for w in words]
+    wanted = [_norm_token(t) for t in script_tokens]
+    out = []
+    matcher = difflib.SequenceMatcher(None, heard, wanted, autojunk=False)
+    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
+        if tag == "equal":
+            for k in range(i2 - i1):
+                out.append({**words[i1 + k], "word": script_tokens[j1 + k]})
+            continue
+        if tag == "delete":
+            continue
+        if keep_heard_digits and i2 > i1 and all(
+                any(c.isdigit() for c in words[k]["word"]) for k in range(i1, i2)):
+            out.extend(dict(words[k]) for k in range(i1, i2))
+            continue
+        if i2 > i1:
+            start, end = words[i1]["start"], words[i2 - 1]["end"]
+        else:
+            start = words[i1 - 1]["end"] if i1 > 0 else words[0]["start"]
+            end = words[i1]["start"] if i1 < len(words) else start + 0.3 * (j2 - j1)
+            if end <= start:
+                end = start + 0.2 * (j2 - j1)
+        step = (end - start) / (j2 - j1)
+        for k in range(j2 - j1):
+            out.append({"word": script_tokens[j1 + k],
+                        "start": start + k * step, "end": start + (k + 1) * step})
+    return out
