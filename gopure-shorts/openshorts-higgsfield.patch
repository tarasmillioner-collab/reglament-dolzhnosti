diff --git a/higgsfield_assets.py b/higgsfield_assets.py
new file mode 100644
index 0000000..57d565a
--- /dev/null
+++ b/higgsfield_assets.py
@@ -0,0 +1,123 @@
+"""
+Higgsfield as an AI Shorts media provider.
+
+The built-in AI Shorts modes generate every asset themselves: an actor portrait
+on fal.ai, a voiceover on ElevenLabs, a lip-synced talking head on fal.ai and
+the b-roll on fal.ai. In "higgsfield" mode those four assets are produced on
+Higgsfield instead (Nano Banana Pro for images, ElevenLabs v4 for voice, Gemini
+Omni Flash for video with native speech) and dropped into an asset set; this
+module stages that set under the file names generate_full_video() already
+caches, so the rest of the pipeline (word-level subtitles, b-roll compositing,
+AI marking) runs unchanged.
+
+Asset set layout, one directory per script under HIGGSFIELD_ASSETS_DIR:
+
+    <asset_id>/
+        manifest.json   {"models": {...}, "credits": {...}}   (optional)
+        actor.png       actor portrait
+        head.mp4        the talking track, audio included
+        voice.mp3       optional; extracted from head.mp4 when missing
+        broll_0.mp4     b-roll for the first segment with visual="broll"
+        broll_1.mp4     ...
+
+The set is found by script["asset_id"], falling back to the slug of the title.
+"""
+
+import json
+import os
+import re
+import shutil
+import subprocess
+from typing import Callable, Dict, List
+
+ASSETS_DIR = os.environ.get(
+    "HIGGSFIELD_ASSETS_DIR",
+    os.path.join(os.path.dirname(os.path.abspath(__file__)), "output", "higgsfield_assets"),
+)
+
+
+def _slug(text: str) -> str:
+    return re.sub(r"[^a-z0-9]+", "_", (text or "").lower()).strip("_")
+
+
+def find_asset_set(script: dict) -> str:
+    candidates = [script.get("asset_id"), _slug(script.get("title", ""))]
+    for name in candidates:
+        if not name:
+            continue
+        path = os.path.join(ASSETS_DIR, name)
+        if os.path.isfile(os.path.join(path, "head.mp4")):
+            return path
+    raise FileNotFoundError(
+        f"No Higgsfield asset set for script '{script.get('title', '')}' in {ASSETS_DIR} "
+        f"(looked for {', '.join(c for c in candidates if c)})"
+    )
+
+
+def load_manifest(asset_dir: str) -> dict:
+    path = os.path.join(asset_dir, "manifest.json")
+    if not os.path.exists(path):
+        return {}
+    with open(path, encoding="utf-8") as f:
+        return json.load(f)
+
+
+def _extract_voice(head_path: str, voice_path: str) -> None:
+    subprocess.run(
+        ["ffmpeg", "-y", "-loglevel", "error", "-i", head_path, "-vn",
+         "-c:a", "libmp3lame", "-b:a", "160k", voice_path],
+        check=True,
+    )
+
+
+def stage_assets(
+    script: dict,
+    paths: Dict[str, str],
+    broll_paths: List[str],
+    log: Callable[[str], None] = print,
+) -> dict:
+    """Copy one asset set onto the cache paths generate_full_video() checks.
+
+    paths: {"actor": ..., "voice": ..., "head": ...}
+    broll_paths: cache path per b-roll segment, in segment order.
+    Returns the set's manifest.
+    """
+    asset_dir = find_asset_set(script)
+    manifest = load_manifest(asset_dir)
+    models = manifest.get("models", {})
+    log(f"[Higgsfield] Using asset set '{os.path.basename(asset_dir)}'")
+
+    actor_src = os.path.join(asset_dir, "actor.png")
+    if os.path.exists(actor_src) and not os.path.exists(paths["actor"]):
+        shutil.copy2(actor_src, paths["actor"])
+    log(f"  actor   <- {models.get('image', 'Higgsfield image')}")
+
+    shutil.copy2(os.path.join(asset_dir, "head.mp4"), paths["head"])
+    log(f"  video   <- {models.get('video', 'Higgsfield video')}")
+
+    voice_src = os.path.join(asset_dir, "voice.mp3")
+    if os.path.exists(voice_src):
+        shutil.copy2(voice_src, paths["voice"])
+    else:
+        _extract_voice(paths["head"], paths["voice"])
+    log(f"  voice   <- {models.get('voice', 'native audio of the video model')}")
+
+    staged = 0
+    for i, dest in enumerate(broll_paths):
+        src = os.path.join(asset_dir, f"broll_{i}.mp4")
+        if os.path.exists(src):
+            shutil.copy2(src, dest)
+            staged += 1
+    if broll_paths:
+        log(f"  b-roll  <- {models.get('broll', models.get('video', 'Higgsfield video'))} "
+            f"({staged}/{len(broll_paths)} clips)")
+    return manifest
+
+
+def cost_estimate(manifest: dict) -> dict:
+    """Credits as recorded by whoever generated the set (Higgsfield bills in credits)."""
+    credits = {k: v for k, v in manifest.get("credits", {}).items() if isinstance(v, (int, float))}
+    credits["ffmpeg_compositing"] = 0
+    credits["total"] = round(sum(credits.values()), 2)
+    credits["unit"] = "credits"
+    return credits
