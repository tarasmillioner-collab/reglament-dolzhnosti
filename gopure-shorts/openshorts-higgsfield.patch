+"""Run the OpenShorts API and the built dashboard on one port.
+
+The repo's docker-compose runs the dashboard as a separate Vite dev server that
+proxies /api, /videos, /gallery and /video to the backend. Where Docker is not
+available we mount the production build (dashboard/dist) on the same FastAPI
+app instead: every API route is registered first, the static mount only
+catches what is left, so the dashboard's relative fetches hit the API as-is.
+"""
+import os
+
+from fastapi.staticfiles import StaticFiles
+
+from app import app
+
+DIST = os.path.join(os.path.dirname(os.path.abspath(__file__)), "dashboard", "dist")
+app.mount("/", StaticFiles(directory=DIST, html=True), name="dashboard")
+
+if __name__ == "__main__":
+    import uvicorn
+    uvicorn.run(app, host="0.0.0.0", port=int(os.environ.get("PORT", "8000")))
